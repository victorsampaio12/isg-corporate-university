{{!
    @template theme_isgcorp/sidebar

    Sidebar fixa customizada da Universidade Corporativa ISG.
    Renderizada em toda página via standard_top_of_body_html(),
    ver classes/output/core_renderer.php.

    Context variables required for this template:
    * wwwroot - URL base do site
    * sitename - nome exibido ao lado do logo
    * items - array de {label, url, icon, active}
}}
<div class="isg-sidebar" id="isg-sidebar">
    <div class="isg-sidebar-deco" aria-hidden="true"></div>
    <a href="{{wwwroot}}/my/" class="isg-sidebar-brand">
        <img src="{{logourl}}" alt="{{sitename}}" class="isg-sidebar-brand-mark">
    </a>
    <nav class="isg-sidebar-nav" aria-label="{{#str}}pluginname, theme_isgcorp{{/str}}">
        {{#items}}
        <a href="{{url}}" class="isg-sidebar-link {{#active}}active{{/active}}">
            <span class="isg-sidebar-icon" aria-hidden="true">{{{icon}}}</span>
            <span>{{label}}</span>
        </a>
        {{/items}}
    </nav>
</div>
